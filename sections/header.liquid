<!-- Header Markup -->
<header class="custom-header">
  <div class="header-inner">
    <!-- Mobile Menu Icon / Close Button -->
    <button class="menu-toggle" aria-label="Toggle menu">
      <span class="menu-icon">&#9776;</span> <!-- Hamburger -->
      <span class="close-icon">&times;</span> <!-- Close ("×") -->
    </button>

    <!-- Site Title -->
    <div class="site-title">TISSO VISON</div>

    <!-- Desktop Slogan and CTA -->
    <div class="desktop-extra">
      <span class="slogan">Find the ideal gift for your loved ones.</span>
      <a href="/collections/gifts" class="choose-gift-btn">
        CHOOSE GIFT <span class="arrow">&#8594;</span>
      </a>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu">
    <div class="site-title mobile-menu-title">TISSO VISON</div>
    <span class="slogan">Find the ideal gift for your loved ones.</span>
    <a href="/collections/gifts" class="choose-gift-btn">
      CHOOSE GIFT <span class="arrow">&#8594;</span>
    </a>
  </div>
</header>
