<section class="custom-banner">
  <div class="custom-banner__container">
    
    <!-- LEFT SIDE (TEXT + BUTTON) -->
    <div class="custom-banner__text">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
      <a href="{{ section.settings.button_link }}" class="custom-banner__button">
        {{ section.settings.button_text }}
      </a>
    </div>

    <!-- RIGHT SIDE (ILLUSTRATION / VECTOR) -->
 <div class="custom-banner__image">
  {% if section.settings.banner_svg != blank %}
    <img 
      src="{{ section.settings.banner_svg | image_url: width: 600 }}" 
      alt="Banner Illustration"
      width="600"
      height="auto"
      loading="lazy">
  {% else %}
    <!-- Fallback static image -->
    <img 
      src="https://cdn.shopify.com/s/files/1/0970/5321/2753/files/Frame.svg?v=1756619962" 
      alt="Banner Illustration"
      width="600"
      height="auto"
      loading="lazy">
  {% endif %}
</div>

    
  </div>
</section>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gift Shop"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Discover our exclusive collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    
    {
  "type": "image_picker",
  "id": "banner_svg",
  "label": "Upload Banner Illustration"
}

    
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}

<style>
.custom-banner {
  width: 100%;
  padding: 60px 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #fff; /* match your figma bg */
}

.custom-banner__container {
  max-width: 1200px;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40px;
}

.custom-banner__text {
  flex: 1;
  text-align: left;
}

.custom-banner__text h2 {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 15px;
  color: #000;
}

.custom-banner__text p {
  font-size: 1.2rem;
  margin-bottom: 25px;
  color: #333;
}

.custom-banner__button {
  background-color: black;
  color: white;
  padding: 14px 32px;
  text-decoration: none;
  font-weight: 600;
  display: inline-block;
  border-radius: 6px;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.custom-banner__button:hover {
  background-color: #FFD700; /* Yellow hover */
  color: black;
}

.custom-banner__image {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.custom-banner__image img {
  max-width: 100%;
  height: auto;
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .custom-banner__container {
    flex-direction: column;
    text-align: center;
  }

  .custom-banner__text {
    text-align: center;
  }

  .custom-banner__image {
    justify-content: center;
    margin-top: 20px;
  }
}
</style>
