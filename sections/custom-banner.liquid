{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover joy. Your ultimate Holiday Gift Destination."
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "Sustainable, ethically made clothes in sizes XS to 4XL."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}

<section class="custom-banner-section">
  <div class="banner-header-row">
    <div class="banner-header-left">TISSO VISON</div>
    <div class="banner-header-center">Find the ideal gift for your loved ones.</div>
    <a href="#" class="banner-header-btn">
      CHOOSE GIFT <span class="arrow">→</span>
    </a>
  </div>
  <div class="banner-background">
    <img src="{{ 'banner-art.svg' | asset_url }}" alt="" width="1052" height="400" loading="lazy" />
  </div>
  <div class="banner-content">
    <h2>{{ section.settings.heading }}</h2>
    <p class="banner-subheading">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.button_link }}" class="banner-btn">
      {{ section.settings.button_text }} <span class="arrow">→</span>
    </a>
    <div class="banner-caption">{{ section.settings.caption }}</div>
  </div>
</section>

<style>
.banner-header-row {
  width: 100vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px 38px 22px 42px;
  background: #fafafa;
  font-family: inherit;
  font-size: 1.12rem;
  font-weight: 400;
  letter-spacing: 0.01em;
  position: relative;
  z-index: 3;
}
.banner-header-left {
  font-size: 1.36rem;
  font-weight: bold;
  letter-spacing: 0.06em;
  color: #111;
  font-family: 'Arial Black', Arial, sans-serif;
}
.banner-header-center {
  margin: 0 auto;
  text-align: center;
  flex: 1 1 auto;
  color: #181818;
  font-size: 1rem;
  font-weight: 400;
}
.banner-header-btn {
  display: inline-flex;
  align-items: center;
  background: #ffe733;
  color: #111;
  font-weight: 600;
  padding: 15px 40px;
  text-decoration: none;
  font-size: 1.13rem;
  border-radius: 0;
  box-shadow: none;
  border: none;
  margin-left: 22px;
  transition: background 0.18s, color 0.18s, box-shadow 0.16s;
  letter-spacing: 0.02em;
}
.banner-header-btn .arrow {
  margin-left: 12px;
  font-weight: bold;
  display: inline-block;
  transition: transform 0.15s;
  font-size: 1.14em;
}
.banner-header-btn:hover {
  background: #fff700;
  color: #000;
  box-shadow: 0 3px 11px rgba(0,0,0,0.08);
}
.banner-header-btn:hover .arrow {
  transform: translateX(4px);
}

@media (max-width: 900px) {
  .banner-header-row {
    flex-direction: column;
    align-items: flex-start;
    padding: 16px 9vw;
    font-size: 1rem;
  }
  .banner-header-left, .banner-header-btn { margin-bottom: 8px; }
  .banner-header-center { text-align: left; width: 100%; }
}

.custom-banner-section {
  position: relative;
  width: 100vw;
  overflow: hidden;
  background: #fff;
}
.banner-background {
  width: 100vw;
  min-height: 390px;
  max-height: 480px;
  overflow: visible;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  background: #fff;
}
.banner-background img {
  width: 100vw;
  min-height: 390px;
  max-height: 480px;
  object-fit: cover;
  object-position: top left;
}

.banner-content {
  position: relative;
  z-index: 1;
  max-width: 550px;
  margin-left: 3vw;
  padding: 60px 0 40px 0;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
}

.custom-banner-section h2 {
  font-size: 2.85rem;
  margin: 0 0 18px 0;
  font-weight: 700;
  line-height: 1.16;
}

.banner-subheading {
  font-size: 1.17rem;
  color: #222;
  margin-bottom: 23px;
}

.banner-btn {
  margin-bottom: 20px;
}

.banner-btn .arrow {
  display: inline-block;
  margin-left: 8px;
  transition: transform 0.25s;
}
.banner-btn:hover {
  background: #222;
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 2px 12px rgba(0,0,0,0.09);
}
.banner-btn:hover .arrow {
  transform: translateX(3px);
}
.banner-caption {
  margin-top: 38px;
  color: #888;
  font-size: 1rem;
  letter-spacing: 0.02em;
}

/* Responsive */
@media (max-width: 900px) {
  .banner-content { padding: 32px 16px 28px 16px; }
  .banner-background { height: 240px; }
}
@media (max-width: 600px) {
  .banner-background { height: 160px; }
  .custom-banner-section h2 { font-size: 1.5rem; }
  .banner-content { padding: 18px 8px 8px 8px; }
}
</style>
