{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover joy. Your ultimate Holiday Gift Destination."
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption",
      "default": "Sustainable, ethically made clothes in sizes XS to 4XL."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}

<section class="custom-banner-section">
  <div class="banner-background">
<img src="{{ 'banner-art.svg' | asset_url }}" alt="" width="1052" height="400" loading="lazy" />
  </div>
  <div class="banner-content">
    <h2>{{ section.settings.heading }}</h2>
    <p class="banner-subheading">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.button_link }}" class="banner-btn">
      {{ section.settings.button_text }} <span class="arrow">→</span>
    </a>
    <div class="banner-caption">{{ section.settings.caption }}</div>
  </div>
</section>

<style>
.custom-banner-section {
  position: relative;
  width: 100vw;
  overflow: hidden;
  background: #fff;
}
.banner-background {
  width: 100vw;
  min-height: 390px;
  max-height: 480px;
  overflow: visible;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  background: #fff;
}
.banner-background img {
  width: 100vw;
  min-height: 390px;
  max-height: 480px;
  object-fit: cover;
  object-position: top left;
}

.banner-content {
  position: relative;
  z-index: 1;
  max-width: 550px;
  margin-left: 3vw;
  padding: 60px 0 40px 0;
  text-align: left;
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
}

.custom-banner-section h2 {
  font-size: 2.85rem;
  margin: 0 0 18px 0;
  font-weight: 700;
  line-height: 1.16;
}

.banner-subheading {
  font-size: 1.17rem;
  color: #222;
  margin-bottom: 23px;
}

.banner-btn {
  margin-bottom: 20px;
}

.banner-btn .arrow {
  display: inline-block;
  margin-left: 8px;
  transition: transform 0.25s;
}
.banner-btn:hover {
  background: #222;
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 2px 12px rgba(0,0,0,0.09);
}
.banner-btn:hover .arrow {
  transform: translateX(3px);
}
.banner-caption {
  margin-top: 38px;
  color: #888;
  font-size: 1rem;
  letter-spacing: 0.02em;
}

/* Responsive */
@media (max-width: 900px) {
  .banner-content { padding: 32px 16px 28px 16px; }
  .banner-background { height: 240px; }
}
@media (max-width: 600px) {
  .banner-background { height: 160px; }
  .custom-banner-section h2 { font-size: 1.5rem; }
  .banner-content { padding: 18px 8px 8px 8px; }
}
</style>
